# Copy this file to `.env` (in this same backend/ directory) and fill in
# any values you need. All settings have safe defaults, so the app runs
# fully with an empty .env - only DEEPSEEK_API_KEY (or ANTHROPIC_API_KEY)/
# RAINFOREST_API_KEY unlock their respective AI/live-data features.

# SQLite connection URL. Relative sqlite URLs are resolved to an
# absolute path under <repo_root>/data/ regardless of current working
# directory - see app/core/config.py. Change this to a real Postgres DSN
# (e.g. postgresql://user:pass@host:5432/dbname) to swap databases later.
DATABASE_URL=sqlite:///../data/product_hunter.db

# Which MarketDataProvider to use: "mock" (default, fully offline/deterministic)
# or "rainforest" (real Amazon data via the Rainforest API - requires
# RAINFOREST_API_KEY below).
DATA_PROVIDER=mock

# Which LLM provider powers app/ai/agent.py: "deepseek" (default, low-cost
# Chinese model, OpenAI-compatible API) or "anthropic" (Claude).
LLM_PROVIDER=deepseek

# DeepSeek API key (https://platform.deepseek.com/api_keys). Only needed
# when LLM_PROVIDER=deepseek. Leave blank to run the app with all
# AI-dependent endpoints (review analysis, opportunity generation)
# returning a clear 503 instead of crashing.
DEEPSEEK_API_KEY=

# Anthropic API key (https://console.anthropic.com/). Only needed when
# LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Rainforest API key (https://www.rainforestapi.com/). Only needed if
# DATA_PROVIDER=rainforest.
RAINFOREST_API_KEY=

# Directory where the Chroma vector store persists its data. Resolved to
# an absolute path under <repo_root>/data/chroma - see app/core/config.py.
CHROMA_PERSIST_DIR=../data/chroma

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:3000
